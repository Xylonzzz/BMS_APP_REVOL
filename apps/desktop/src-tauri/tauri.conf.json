{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "REVOL",
  "version": "0.1.0",
  "identifier": "com.revol.battery-workspace",
  "build": {"frontendDist": "../ui"},
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label": "main", "title": "REVOL · 电池工作台", "width": 900, "height": 740, "minWidth": 760, "minHeight": 680, "backgroundColor": "#F3F6FB"}],
    "security": {"csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {"../sidecar/revol-sidecar/": "sidecar/"},
    "windows": {"webviewInstallMode": {"type": "skip"}, "nsis": {"displayLanguageSelector": false, "languages": ["SimpChinese"], "installMode": "currentUser"}}
  }
}
